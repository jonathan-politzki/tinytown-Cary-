# Fingerprinted assets can be reused; site/manifest updates still revalidate.
# The no-cache rules for each route document are generated per deploy target by
# `town stage` from sites/*/site.json, and land above these lines.
/data/:site/surfaces-*.bin.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
/data/:site/surfaces.json
  Cache-Control: no-cache
/data/:site/stream/*.bin.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
/data/:site/stream/manifest.json
  Cache-Control: no-cache
